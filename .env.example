# Variables lues par docker-compose.yml. `npm run setup` crée .env avec des secrets générés.

# Secrets Strapi (à générer, ex. : node -e "console.log(require('crypto').randomBytes(24).toString('base64'))")
APP_KEYS=tobemodified1,tobemodified2
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
# Partagé entre Strapi et Next.js pour l'invalidation du cache
REVALIDATE_SECRET=tobemodified

# PostgreSQL
DATABASE_NAME=communaute
DATABASE_USERNAME=communaute
DATABASE_PASSWORD=communaute
# Port exposé sur la machine hôte (changer si un PostgreSQL local occupe déjà 5432)
POSTGRES_HOST_PORT=5432

# Données de démonstration
DEMO_USER_PASSWORD=Communaute2026!
SEED_ADMIN_EMAIL=admin@demo.lerevenu.test
# Laisser vide pour créer le compte administrateur via l'écran d'inscription de Strapi
SEED_ADMIN_PASSWORD=
