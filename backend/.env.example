# --- Serveur -----------------------------------------------------------------
HOST=0.0.0.0
PORT=1337

# --- Secrets (à générer : `npm run setup` à la racine le fait automatiquement) ---
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# --- Base de données -----------------------------------------------------------
# PostgreSQL (cible du projet) — `docker compose up postgres` en fournit une en local.
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=communaute
DATABASE_USERNAME=communaute
DATABASE_PASSWORD=communaute
DATABASE_SSL=false
# Variante sans installation : décommentez pour utiliser SQLite (fichier local).
# DATABASE_CLIENT=sqlite
# DATABASE_FILENAME=.tmp/data.db

# --- Front Next.js -------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
# Invalidation du cache Next.js quand un contenu change dans Strapi (laisser vide pour désactiver)
FRONTEND_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=tobemodified

# --- Données de démonstration --------------------------------------------------
# Création automatique au premier démarrage si la base est vide
SEED_DEMO_DATA=true
# Mot de passe commun aux membres de démonstration (voir README)
DEMO_USER_PASSWORD=Communaute2026!
# Premier compte administrateur Strapi (laisser vide pour le créer via l'écran d'inscription)
SEED_ADMIN_EMAIL=admin@demo.lerevenu.test
SEED_ADMIN_PASSWORD=
