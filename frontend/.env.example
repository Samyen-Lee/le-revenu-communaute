# URL de l'API Strapi, appelée uniquement côté serveur (Server Components / Server Actions)
STRAPI_URL=http://localhost:1337

# Secret partagé avec Strapi pour l'invalidation du cache (POST /api/revalidate)
REVALIDATE_SECRET=tobemodified

# Affiche les comptes de démonstration sur la page de connexion
DEMO_MODE=true
# Mot de passe des comptes de démonstration (identique à DEMO_USER_PASSWORD côté Strapi)
DEMO_USER_PASSWORD=Communaute2026!
